generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id
  name              String
  email             String
  emailVerified     Boolean
  image             String?
  createdAt         DateTime
  updatedAt         DateTime
  sessions          Session[]
  accounts          Account[]
  workSpaces        WorkSpace[]
  events            Event[]
  templates         EventTemplate[]
  calendarFeedToken CalendarFeedToken?
  polls             Poll[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model WorkSpace {
  id        String            @id @default(uuid())
  name      String
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  members   WorkSpaceMember[]
  createdAt DateTime          @default(now())

  @@unique([userId, name])
  @@index([userId])
  @@map("workspaces")
}

model WorkSpaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   WorkSpace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String?
  email       String
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@map("workspace_members")
}

model Event {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  desc              String
  eventAt           DateTime
  location          String
  emailSubject      String
  emailBody         String
  status            EventStatus     @default(active)
  cancelledAt       DateTime?
  scheduledAt       DateTime?
  sentAt            DateTime?
  autoInvite        Boolean?        @default(false)
  inviteSendOffset  Int?
  recurrence        Recurrence?
  parentEventId     String?
  parentEvent       Event?          @relation("RecurringEvents", fields: [parentEventId], references: [id], onDelete: SetNull)
  childEvents       Event[]         @relation("RecurringEvents")
  finalizedFromPoll Poll?           @relation("PollFinalEvent")
  createdAt         DateTime        @default(now())
  invitations       Invitation[]
  templates         EventTemplate[]

  @@index([userId])
  @@index([userId, status])
  @@index([status, scheduledAt])
  @@map("events")
}

model Invitation {
  id                  String           @id @default(uuid())
  eventId             String
  event               Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email               String
  name                String?
  token               String           @unique
  status              InvitationStatus @default(pending)
  personalizedOpening String?
  openedAt            DateTime?
  guestNote           String?
  organizerNote       String?
  respondedAt         DateTime?
  sentAt              DateTime         @default(now())
  updatedAt           DateTime?        @updatedAt

  @@unique([eventId, email])
  @@index([eventId])
  @@index([token])
  @@index([eventId, status])
  @@map("invitations")
}

model EventTemplate {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId      String?
  event        Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  name         String
  emailSubject String
  emailBody    String
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("event_templates")
}

enum EventStatus {
  active
  cancelled
  scheduled
}

enum InvitationStatus {
  pending
  attending
  declined
  maybe
}

enum Recurrence {
  weekly
  monthly
  annually
}

model CalendarFeedToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
  @@map("calendar_feed_tokens")
}

enum PollStatus {
  open
  finalized
  cancelled
}

model Poll {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  location     String?
  closesAt     DateTime?
  status       PollStatus    @default(open)
  finalEventId String?       @unique
  finalEvent   Event?        @relation("PollFinalEvent", fields: [finalEventId], references: [id], onDelete: SetNull)
  finalizedAt  DateTime?
  options      PollOption[]
  invitees     PollInvitee[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@map("polls")
}

model PollOption {
  id        String     @id @default(uuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime?
  votes     PollVote[]
  createdAt DateTime   @default(now())

  @@index([pollId])
  @@map("poll_options")
}

model PollInvitee {
  id          String     @id @default(uuid())
  pollId      String
  poll        Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  email       String
  name        String?
  token       String     @unique
  respondedAt DateTime?
  votes       PollVote[]
  createdAt   DateTime   @default(now())

  @@unique([pollId, email])
  @@index([pollId])
  @@index([token])
  @@map("poll_invitees")
}

model PollVote {
  id        String      @id @default(uuid())
  optionId  String
  option    PollOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  inviteeId String
  invitee   PollInvitee @relation(fields: [inviteeId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([optionId, inviteeId])
  @@index([inviteeId])
  @@map("poll_votes")
}
